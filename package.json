{
  "name": "@esyion/totp-auth",
  "version": "1.0.0",
  "description": "Time-based One-Time Password (TOTP) implementation for Node.js, based on RFC 6238/4226, compatible with Google Authenticator",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "jest",
    "docs": "typedoc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "totp",
    "hotp",
    "otp",
    "2fa",
    "two-factor",
    "authentication",
    "google-authenticator",
    "rfc6238",
    "rfc4226"
  ],
  "author": "esyion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esyion/totp-auth.git"
  },
  "bugs": {
    "url": "https://github.com/esyion/totp-auth/issues"
  },
  "homepage": "https://github.com/esyion/totp-auth#readme",
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "jest": "^29.7.0",
    "rollup": "^4.5.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.2.2"
  }
}
